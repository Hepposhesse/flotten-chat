#!/usr/bin/env bash
# send — Nachricht auf den flotten-chat-kit-Bus legen (Gegenstück: Claude-Fenster lesen ihren Kanal).
#
#   send <kanal> "<text>" [--von <name>] [--typ task|fyi|done|answer|accept|frage|error] [--bezug <id>]
#   send <kanal> --body-file <pfad> [...flags]     # Text aus Datei (robust bei Sonderzeichen)
#
# Konventionen (siehe CLAUDE.md): --von ist PFLICHT für Agenten (sonst zählt es als Chef-Nachricht).
# done/answer brauchen --bezug <id> der beantworteten Nachricht. "/btw <text>" = Nebenbemerkung
# (Dispatcher weckt sanft; Fenster antwortet kurz, ohne die Arbeit zu unterbrechen).
set -euo pipefail
HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG="$HIER/../kit.config.json"
URL="${KIT_URL:-$(python3 -c "import json;c=json.load(open('$CFG'));print(c.get('url') or 'http://127.0.0.1:'+str(c['port']))")}"
TOKEN="${KIT_TOKEN:-$(python3 -c "import json;print(json.load(open('$CFG'))['token'])")}"

KANAL="${1:-}"; shift || true
TEXT=""; VON="chef"; TYP="fyi"; BEZUG=""; BODYFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --von) VON="$2"; shift 2;;
    --typ) TYP="$2"; shift 2;;
    --bezug) BEZUG="$2"; shift 2;;
    --body-file) BODYFILE="$2"; shift 2;;
    --*) echo "send: unbekannter Flag '$1'" >&2; exit 64;;
    *) TEXT="$1"; shift;;
  esac
done
[ -n "$BODYFILE" ] && TEXT="$(cat "$BODYFILE")"
if [ -z "$KANAL" ] || [ -z "$TEXT" ]; then
  echo "Nutzung: send <kanal> \"<text>\" [--von N] [--typ T] [--bezug ID] | --body-file <pfad>" >&2; exit 64
fi
BODY=$(python3 -c "
import json, sys
d = {'kanal': sys.argv[1], 'von': sys.argv[2], 'typ': sys.argv[3], 'inhalt': sys.stdin.read()}
if sys.argv[4]: d['bezug'] = int(sys.argv[4])
print(json.dumps(d))
" "$KANAL" "$VON" "$TYP" "$BEZUG" <<< "$TEXT")
curl -sf -X POST "$URL/api/nachrichten" \
  -H "Authorization: Bearer $TOKEN" -H "content-type: application/json" \
  -d "$BODY" >/dev/null \
  && echo "gesendet -> $KANAL (von $VON, $TYP)" \
  || { echo "send FEHLGESCHLAGEN (läuft der Bus? -> bash install.sh)" >&2; exit 1; }
